// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum AffiliateStatus {
  pending
  approved
  rejected
  suspended
}

enum CommissionType {
  percent
  fixed
}

enum CommissionOn {
  subtotal_before_coupon
  subtotal_after_coupon
}

enum ClickSource {
  referral_link
  coupon_code_attempt
}

enum AttributionSource {
  referral_link
  coupon_code
  both
}

enum ConversionStatus {
  pending
  approved
  paid
  reversed
  voided
}

enum PayoutStatus {
  pending
  approved
  paid
  rejected
}

model Affiliate {
  id                    String            @id @default(cuid())
  userEmail             String            @unique
  displayName           String?
  emailNotifications    Boolean           @default(true)
  status                AffiliateStatus   @default(pending)
  suspendReason         String?
  referralSlug          String            @unique
  shopifyDiscountCode   String?           @unique
  shopifyDiscountValue  Float             @default(10)
  commissionRate        Float             @default(10)
  commissionType        CommissionType    @default(percent)
  commissionOn          CommissionOn      @default(subtotal_after_coupon)
  cookieDurationDays     Int              @default(30)
  pendingPeriodDays      Int              @default(30)
  minimumPayoutThreshold Float            @default(50)
  payoutMethod          String?
  payoutDetails         Json?

  parentAffiliateId     String?
  parentAffiliate       Affiliate?        @relation("AffiliateTeam", fields: [parentAffiliateId], references: [id])
  subAffiliates         Affiliate[]       @relation("AffiliateTeam")
  parentOverrideRate    Float?

  // Whether this affiliate may recruit a team (invite link, QR, new sub-affiliates). Admin-controlled.
  // Turning it off stops NEW recruiting only; their existing team and earnings are untouched.
  canRecruit            Boolean           @default(true)

  // 90-day activity cycle (only used while the program switch is on). The cycle ends at cycleEndsAt:
  // an affiliate who met the requirement rolls into a new cycle and stays active until it ends,
  // one who did not is suspended. activeUntil carries "active" across a rollover so uplines keep
  // counting a recruit who passed last cycle.
  cycleStartedAt        DateTime?
  cycleEndsAt           DateTime?
  activeUntil           DateTime?
  cycleWarningStage     Int               @default(0)

  flaggedForReview      Boolean           @default(false)
  fraudScore            Int               @default(0)
  fraudNotes            String?

  totalClicks           Int               @default(0)
  totalConversions      Int               @default(0)
  totalCommissionEarned   Float           @default(0)
  totalCommissionPending  Float           @default(0)
  totalCommissionApproved Float           @default(0)
  totalCommissionPaid     Float           @default(0)

  clicks                AffiliateClick[]
  conversions           AffiliateConversion[] @relation("AffiliateConversions")
  parentConversions      AffiliateConversion[] @relation("ParentOverrideConversions")
  overrideEarnings      ConversionOverride[]  @relation("EarnedOverrides")
  payouts               AffiliatePayout[]
  notifications         Notification[]

  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt

  @@map("affiliates")
}

model AffiliateClick {
  id                String            @id @default(cuid())
  affiliateId       String
  affiliate         Affiliate         @relation(fields: [affiliateId], references: [id])
  source            ClickSource       @default(referral_link)
  ipHash            String?
  deviceType        String?
  referrer          String?
  sessionId         String?
  convertedToOrder  Boolean           @default(false)
  conversionId      String?           @unique
  isSuspicious      Boolean           @default(false)
  createdAt         DateTime          @default(now())

  @@index([affiliateId])
  @@map("affiliate_clicks")
}

model AffiliateConversion {
  id                    String            @id @default(cuid())
  affiliateId           String
  affiliate             Affiliate         @relation("AffiliateConversions", fields: [affiliateId], references: [id])

  shopifyOrderId        String            @unique
  shopifyOrderName      String?

  attributionSource     AttributionSource
  attributionClickId    String?

  orderSubtotal         Float
  orderDiscount         Float             @default(0)
  eligibleSubtotal      Float
  commissionRate        Float
  commissionAmount      Float

  parentAffiliateId     String?
  parentAffiliate       Affiliate?        @relation("ParentOverrideConversions", fields: [parentAffiliateId], references: [id])
  parentCommissionRate  Float?
  parentCommissionAmount Float?

  // Unilevel plan: one row per paid override slot (up to 5). Empty for legacy single-parent
  // conversions, which use the parentCommission* columns above instead.
  overrides             ConversionOverride[]

  status                ConversionStatus  @default(pending)
  pendingUntil          DateTime?
  reversedReason        String?

  selfReferralDetected  Boolean           @default(false)
  ipMatchesAffiliate    Boolean           @default(false)
  fraudScore            Int               @default(0)

  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt

  @@index([affiliateId])
  @@map("affiliate_conversions")
}

model ConversionOverride {
  id            String              @id @default(cuid())
  conversionId  String
  conversion    AffiliateConversion @relation(fields: [conversionId], references: [id], onDelete: Cascade)
  affiliateId   String
  affiliate     Affiliate           @relation("EarnedOverrides", fields: [affiliateId], references: [id])
  level         Int                 // genealogy level above the seller (1 = direct recruiter)
  slot          Int                 // paid override slot 1..5
  rate          Float
  amount        Float
  createdAt     DateTime            @default(now())

  @@index([affiliateId, createdAt])
  @@index([conversionId])
  @@map("conversion_overrides")
}

model AffiliatePayout {
  id                String            @id @default(cuid())
  affiliateId       String
  affiliate         Affiliate         @relation(fields: [affiliateId], references: [id])
  conversionIds     String[]
  amount            Float
  currency          String            @default("USD")
  status            PayoutStatus      @default(pending)
  payoutMethod      String?
  payoutDetails     Json?
  transactionId     String?
  notes             String?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  @@index([affiliateId])
  @@map("affiliate_payouts")
}

model AffiliateApplication {
  id                    String            @id @default(cuid())
  displayName           String
  firstName             String?
  lastName              String?
  email                 String
  websiteUrl            String?
  socialLinks           Json?
  promotionMethods      String?
  estimatedMonthlyReach String?
  niche                 String?
  agreedToTerms         Boolean           @default(false)

  // Signed IRS Form W-9, uploaded by the applicant so we can 1099-report their affiliate payouts.
  // Stored as a file in Neon Object Storage (S3-compatible, branch-scoped) — not a typed-in
  // SSN/EIN — so we never hold a taxpayer ID as plain text. w9StorageKey is the object key.
  w9StorageKey          String?
  w9FileName            String?
  w9FileType            String?
  w9VerifiedAt          DateTime?
  w9VerifiedBy          String?

  referredByAffiliateId String?
  status                AffiliateStatus   @default(pending)
  reviewNotes           String?
  linkedAffiliateId     String?
  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt

  @@map("affiliate_applications")
}

// Public "become a sales rep" signup. Deliberately light: only an email is required so we can reach
// the person; a resume can stand in for the rest. Separate from AffiliateApplication (which
// requires a W-9) — a rep is converted to an agent/affiliate on review.
model SalesRepSignup {
  id                    String            @id @default(cuid())
  firstName             String?
  lastName              String?
  email                 String
  phone                 String?
  annualGrossSales      Float?
  salesType             String?
  // Membership plan chosen on the form (a key from src/lib/membership/plans.ts). Billing isn't
  // connected yet, so this only records the choice.
  plan                  String?

  resumeStorageKey      String?
  resumeFileName        String?
  resumeFileType        String?

  referredByAffiliateId String?
  status                AffiliateStatus   @default(pending)
  reviewNotes           String?
  linkedAffiliateId     String?
  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt

  @@index([email])
  @@map("sales_rep_signups")
}

enum CustomerSignupStatus {
  pending_payment
  active
  past_due
  cancelled
}

// A customer choosing a monthly membership (plan keys live in src/lib/membership/plans.ts).
// Created as pending_payment; recurring billing activates it.
model CustomerSignup {
  id                    String               @id @default(cuid())
  firstName             String
  lastName              String
  email                 String
  phone                 String?
  plan                  String
  wantsTestKit          Boolean              @default(false)

  referredByAffiliateId String?
  status                CustomerSignupStatus @default(pending_payment)

  // Membership lifecycle. A payment (recorded by an admin today, by a payment provider later)
  // activates the membership and pushes currentPeriodEnd out by a month; a lapse flips it to
  // past_due. The member discount code exists in Shopify only while the membership is in good
  // standing (memberDiscountActive).
  activatedAt           DateTime?
  currentPeriodEnd      DateTime?
  cancelledAt           DateTime?
  memberDiscountCode    String?              @unique
  memberDiscountActive  Boolean              @default(false)
  consultationsUsed     Int                  @default(0)

  // Complimentary membership: an admin granted access without a payment (a friend, a partner).
  // It never lapses, takes no payment and pays no commission, until it is cancelled or a real
  // payment is recorded.
  complimentary         Boolean              @default(false)
  complimentaryNote     String?
  complimentaryBy       String?

  payments              MembershipPayment[]
  loginTokens           CustomerLoginToken[]
  consultations         MemberConsultation[]

  createdAt             DateTime             @default(now())
  updatedAt             DateTime             @updatedAt

  @@index([email])
  @@map("customer_signups")
}

// One row per membership payment. (source, externalId) is unique so a provider webhook that is
// delivered twice can't credit the same payment twice.
model MembershipPayment {
  id          String         @id @default(cuid())
  customerId  String
  customer    CustomerSignup @relation(fields: [customerId], references: [id], onDelete: Cascade)
  amount      Float
  source      String         // "manual" today; a provider name later
  externalId  String?
  periodStart DateTime
  periodEnd   DateTime
  note        String?
  createdAt   DateTime       @default(now())

  @@unique([source, externalId])
  @@index([customerId, createdAt])
  @@map("membership_payments")
}

model CustomerLoginToken {
  id         String         @id @default(cuid())
  customerId String
  customer   CustomerSignup @relation(fields: [customerId], references: [id], onDelete: Cascade)
  token      String         @unique
  expiresAt  DateTime
  usedAt     DateTime?
  createdAt  DateTime       @default(now())

  @@map("customer_login_tokens")
}

model AdminLoginToken {
  id        String    @id @default(cuid())
  email     String
  token     String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@map("admin_login_tokens")
}

model AffiliateLoginToken {
  id          String    @id @default(cuid())
  affiliateId String
  token       String    @unique
  expiresAt   DateTime
  usedAt      DateTime?
  createdAt   DateTime  @default(now())

  @@map("affiliate_login_tokens")
}

model Notification {
  id          String    @id @default(cuid())
  affiliateId String
  affiliate   Affiliate @relation(fields: [affiliateId], references: [id])
  type        String
  title       String
  body        String?
  readAt      DateTime?
  createdAt   DateTime  @default(now())

  @@index([affiliateId, createdAt])
  @@map("notifications")
}

model AffiliateSettings {
  id                            String   @id @default("global")
  defaultCommissionRate         Float    @default(10)
  defaultCommissionType         CommissionType @default(percent)
  defaultCommissionOn           CommissionOn   @default(subtotal_after_coupon)
  defaultCookieDurationDays     Int      @default(30)
  defaultPendingPeriodDays      Int      @default(30)
  defaultMinimumPayoutThreshold Float    @default(50)
  defaultParentOverrideRate     Float    @default(3)
  defaultCanRecruit             Boolean  @default(true)

  // Unilevel compensation plan (from the client's spreadsheet). Off by default: when off, the
  // legacy flat-rate + single-parent override applies. Values the client hasn't specified
  // (personal sales requirement, what counts as an "active" recruit) default to the least
  // restrictive setting and are meant to be tuned here.
  // Whether membership payments earn the referring rep commission, like a product sale. Off until
  // the client confirms membership fees count as sales.
  membershipCommissionEnabled   Boolean  @default(false)

  // Wallet points (1 point = $1 of store credit). Off until an admin turns it on. Earning rules mirror
  // the 99 Purity Peptides points system: a percent of the order after discounts, with a minimum.
  walletEnabled                 Boolean  @default(false)
  walletOrderEarnPercent        Float    @default(5)
  walletOrderMinSubtotal        Float    @default(300)
  walletMembershipEarnPercent   Float    @default(0)
  walletMinRedeem               Float    @default(5)
  walletRedeemExpiryDays        Int      @default(14)

  // 90-day activity cycle. Off by default so nothing changes until an admin turns it on. Being active
  // means recruiting activityRequiredRecruits affiliates, or reaching activityMinSales in own sales
  // (0 = recruiting only), within each cycle. When on, it replaces the monthly override requirement.
  activityEnabled               Boolean  @default(false)
  activityCycleDays             Int      @default(90)
  activityRequiredRecruits      Int      @default(3)
  activityMinSales              Float    @default(0)

  unilevelEnabled               Boolean  @default(false)
  unilevelMinPersonalSales      Float    @default(0)
  unilevelRequiredRecruits      Int      @default(3)
  unilevelActiveRecruitMinSales Float    @default(0)
  unilevelSlotRates             Float[]  @default([5, 3, 3, 3, 1])
  unilevelSellerTiers           Json     @default("[{\"name\":\"New Sales Person\",\"minMonthlySales\":0,\"rate\":10},{\"name\":\"Developing Producer\",\"minMonthlySales\":2500,\"rate\":15},{\"name\":\"Top Seller Tier\",\"minMonthlySales\":10000,\"rate\":20}]")

  updatedAt                     DateTime @updatedAt

  @@map("affiliate_settings")
}

enum WalletKind {
  customer
  affiliate
}

enum WalletTxType {
  earn
  redeem
  refund
  clawback
  adjustment
}

enum WalletRedemptionStatus {
  pending
  used
  expired
}

// A points balance. ownerKey is the lowercased email for customers (so it survives cancelling and
// rejoining) or the affiliate id for affiliates. balanceCents is a cache of the ledger: 1 point is
// 100 "cents" so points carry cents like money. It is only ever changed together with a ledger row.
model WalletAccount {
  id           String              @id @default(cuid())
  kind         WalletKind
  ownerKey     String
  balanceCents Int                 @default(0)
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt

  transactions WalletTransaction[]
  redemptions  WalletRedemption[]

  @@unique([kind, ownerKey])
  @@map("wallet_accounts")
}

// Append-only ledger. amountCents is signed (credit +, debit -). idempotencyKey makes a retried
// webhook or double click a no-op instead of a second credit.
model WalletTransaction {
  id                String        @id @default(cuid())
  accountId         String
  account           WalletAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  type              WalletTxType
  amountCents       Int
  balanceAfterCents Int
  reason            String?
  sourceType        String?
  sourceId          String?
  idempotencyKey    String?       @unique
  meta              Json?
  createdBy         String?
  createdAt         DateTime      @default(now())

  @@index([accountId, createdAt])
  @@index([sourceType, sourceId])
  @@map("wallet_transactions")
}

// Points a member turned into a single-use Shopify discount code. The points are taken out of the
// balance up front; if the code is not used before it expires they go back.
model WalletRedemption {
  id          String                 @id @default(cuid())
  accountId   String
  account     WalletAccount          @relation(fields: [accountId], references: [id], onDelete: Cascade)
  amountCents Int
  code        String                 @unique
  status      WalletRedemptionStatus @default(pending)
  expiresAt   DateTime
  usedAt      DateTime?
  usedOrderId String?
  // Total of the order the code was used on, so a partial refund can return a matching share.
  usedOrderTotalCents Int?
  createdAt   DateTime               @default(now())

  @@index([accountId, status])
  @@map("wallet_redemptions")
}

// One row per telehealth consultation a member has used, created when an admin logs one. The count
// on CustomerSignup (consultationsUsed) stays the number that limits the plan; these rows are the
// history the member sees.
model MemberConsultation {
  id         String         @id @default(cuid())
  customerId String
  customer   CustomerSignup @relation(fields: [customerId], references: [id], onDelete: Cascade)
  occurredAt DateTime       @default(now())
  title      String         @default("Telehealth consultation")
  status     String         @default("completed")
  notes      String?
  createdBy  String?
  createdAt  DateTime       @default(now())

  @@index([customerId, occurredAt])
  @@map("member_consultations")
}
